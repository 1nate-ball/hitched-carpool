# Optional process environment settings. server.py does not auto-load this file.
# Locally, the defaults work and none of these need to be set.
PORT=8000
# Network interface to listen on. Leave as 127.0.0.1 locally; set 0.0.0.0 on the host.
HOST=127.0.0.1
# HITCH_DB=/absolute/path/to/hitch.sqlite3
# Supabase settings are not env vars: public/supabase-config.json holds the project URL
# and publishable key, which are safe to commit. Never add a secret or service-role key.
